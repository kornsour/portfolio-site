#!/usr/bin/env bash
#
# git pre-push — only what has to happen BEFORE a push, and nothing CI already
# does after one:
#
#   1. Refuse to push to, or delete, main. Changes go through pull requests.
#   2. Scan the commits being pushed for secrets (gitleaks).
#
# A REAL git hook, not a Claude Code hook (scripts/hooks/pre-commit-gate.sh is
# one of those, wired in .claude/settings.json, and only sees commits an agent
# makes through the Bash tool). This one runs for every push from any source.
# An agent authenticates as the operator's own GitHub identity, so nothing on
# GitHub's side can tell "the operator pushed this" from "an agent pushed
# this" — the main guard lives here, where the repo can see which ref is about
# to change, and fails in milliseconds instead of after a round-trip.
#
# NOT HERE, deliberately: `pnpm verify`. Every check in scripts/verify.sh runs
# in CI on every pull request (kornsour/gh-automation's reusable ci.yml and
# lockfile-guard.yml; this repo is public, so those jobs run on GitHub-hosted
# runners at no cost), and all but Semgrep are required status checks on
# main's branch protection. Running it again on every push only duplicated
# CI — and it ran on pushes that carry no code at all (a branch delete from
# git-cleanup failed on an unrelated red check). The hook used to run it
# because Actions minutes were exhausted and CI was not running; that is no
# longer true. Run `pnpm verify` by hand when you want the answer before CI.
#
# BYPASS: `git push --no-verify` skips this hook entirely. That is git's
# behavior and cannot be prevented client-side. The hook is a fast local check,
# not an enforcement boundary — main's repository ruleset (pull request
# required, no deletion, empty bypass list), branch protection, and CI are the
# boundary.
#
# Install with `pnpm hooks:install` (sets core.hooksPath=scripts/hooks, relative
# on purpose so each worktree runs its own copy of this file).
#
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
REPO="$(git rev-parse --show-toplevel)"

# git feeds one line per ref update on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A delete has local sha all zeros. stdin can be read only once, so capture it.
REF_UPDATES="$(cat)"

# ---------------------------------------------------------------------------
# 1. Main guard. Covers deleting main as well as pushing to it. Feature
#    branches, their deletion, and tags pass straight through.
#    ALLOW_MAIN_PUSH=1 is the escape hatch. It only gets the push as far as
#    GitHub: main's ruleset has an empty bypass list, so GitHub still rejects
#    a direct push to or delete of main unless that ruleset is changed first.
# ---------------------------------------------------------------------------
if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
	while read -r _local_ref _local_sha remote_ref _remote_sha; do
		if [ "$remote_ref" = "refs/heads/main" ]; then
			echo "pre-push: refusing to push to main — this repo uses pull requests." >&2
			echo "" >&2
			echo "    git switch -c <branch> && git push -u origin <branch>" >&2
			echo "    gh pr create --fill" >&2
			echo "" >&2
			echo "  If this really must go straight to main:  ALLOW_MAIN_PUSH=1 git push" >&2
			exit 1
		fi
	done <<<"$REF_UPDATES"
fi

# ---------------------------------------------------------------------------
# 2. gitleaks over the commits being pushed — the local half of secret
#    scanning (GitHub secret scanning with push protection, enabled on this
#    repo, is the server-side half). Before is strictly better: a secret that
#    reaches a public remote is exposed from that moment.
#
#    Scans a COMMIT RANGE (`gitleaks git --log-opts`), never a directory:
#    `gitleaks dir` ignores .gitignore and ground for minutes through a 49 GB
#    `.next/` cache (measured 2026-09-05) where a range scan took ~40ms.
#
#    Deletes carry no commits and are skipped, so a delete-only push never
#    invokes gitleaks at all. Missing gitleaks warns and continues.
# ---------------------------------------------------------------------------
status=0
warned=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$ZERO" ] && continue

	if ! command -v gitleaks >/dev/null 2>&1; then
		if [ "$warned" = 0 ]; then
			echo "pre-push: gitleaks not installed; skipping local secret scan (brew install gitleaks)." >&2
			warned=1
		fi
		continue
	fi

	if [ "$remote_sha" = "$ZERO" ]; then
		# New ref on the remote: scan only what it adds beyond the remote's
		# other refs, not the whole repository's history.
		range="$local_sha --not --remotes"
	else
		range="${remote_sha}..${local_sha}"
	fi

	# --redact so a real finding is not written into terminal scrollback.
	if ! gitleaks git --no-banner --redact --exit-code 1 --log-opts "$range" "$REPO"; then
		status=1
	fi
done <<<"$REF_UPDATES"

if [ "$status" -ne 0 ]; then
	cat >&2 <<'MSG'

pre-push: BLOCKED — gitleaks found a secret in the commits you are pushing.

  * A real secret: do NOT just amend the commit. Rotate the credential first;
    it is compromised the moment it exists in a commit you might push.
  * A false positive: add an evidenced entry to .gitleaks.toml (or
    .gitleaksignore) recording what the string is and why it is not a
    credential, then push again.
  * To bypass this check knowingly: git push --no-verify

MSG
	exit 1
fi

exit 0
