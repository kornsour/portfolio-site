{
  "name": "portfolio-edge",
  "main": "worker.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    // run_worker_first so the Worker can attach security headers to every
    // response; a static export cannot emit headers on its own.
    "run_worker_first": true,
    // Serves /writing/agent-guardrails from agent-guardrails.html, matching the
    // CloudFront rewrite function the AWS plan would have used.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // akaiserauer.com is the canonical host. Its zone was empty when it was
  // added, so it is attached as a custom domain: wrangler creates the proxied
  // DNS record and the certificate itself, with nothing to toggle by hand.
  //
  // andrewkaiserauer.com is the previous domain and stays attached only so its
  // links keep working: worker.js 301s every request on it to akaiserauer.com,
  // preserving path and query. Its routes sit over PROXIED records rather than
  // custom_domain because the apex already had an A record, and Cloudflare
  // refuses to create a custom-domain record over existing DNS. Drop those two
  // routes once nothing links to the old domain.
  "routes": [
    { "pattern": "akaiserauer.com", "custom_domain": true },
    { "pattern": "www.akaiserauer.com", "custom_domain": true },
    { "pattern": "andrewkaiserauer.com/*", "zone_name": "andrewkaiserauer.com" },
    { "pattern": "www.andrewkaiserauer.com/*", "zone_name": "andrewkaiserauer.com" }
  ],
  "observability": { "enabled": true }
}
