# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# OpenTofu
**/.terraform/*
*.tfplan
*.tfstate
*.tfstate.*
crash.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated resume cuts the SITE does not offer (currently the IC cut), written
# by `pnpm resume`. Deliberately NOT under public/: this is a static export, so
# anything in public/ is copied into out/ and served at a guessable URL whether
# or not a link points at it. Regenerate with `pnpm resume` and attach by hand.
/resumes/
